[Unit]
Description=GatewayAI private Telegram pilot controller
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
UMask=0077
WorkingDirectory=/opt/gatewayai-pilot
ExecStart=/usr/bin/python3 /opt/gatewayai-pilot/scripts/pilot_server.py serve --config /etc/gatewayai-controller/pilot.json
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/gatewayai-controller
Environment=PYTHONDONTWRITEBYTECODE=1

[Install]
WantedBy=multi-user.target
