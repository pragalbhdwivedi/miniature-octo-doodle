[Unit]
Description=Sync bounded public main context into OpenViking
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/opt/gatewayai-openviking
ExecStart=/usr/bin/python3 /opt/gatewayai-openviking/public.py sync --root /var/lib/gatewayai-openviking
TimeoutStartSec=10min
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/gatewayai-openviking
CapabilityBoundingSet=
