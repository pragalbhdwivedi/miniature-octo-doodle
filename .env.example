# Run scripts/manage.ps1 init to generate local secrets. Never commit .env.
# Registry-verified versions and immutable index digests, 2026-09-29.
POSTGRES_IMAGE=postgres:16-alpine@sha256:721873c34ceb9f8d8fc265984940dc982404c105f19ad51be9fdc5970a6080ea
LITELLM_IMAGE=ghcr.io/berriai/litellm-database:v1.103.0@sha256:f4f114b1996c5923c4d62a7bbdcecb2ccf9df17bdebce76050f609be97f75f5c
OPEN_WEBUI_IMAGE=ghcr.io/open-webui/open-webui:v0.11.4-slim@sha256:0487ad4a5a4b986062dedace806c3ef1e88fec38c10d1e64d6a5501c66671e5e

POSTGRES_USER=litellm
POSTGRES_DB=litellm
POSTGRES_PASSWORD=replace-me-locally
LITELLM_MASTER_KEY=replace-me-locally
LITELLM_SALT_KEY=replace-me-locally
WEBUI_SECRET_KEY=replace-me-locally
WEBUI_ADMIN_EMAIL=admin@example.com
WEBUI_ADMIN_PASSWORD=replace-me-locally
# Automatically provisioned as an inference key by manage.ps1 start.
WEBUI_GATEWAY_KEY=

# Empty credentials omit that provider from the generated gateway config.
OPENAI_API_KEY=
GEMINI_API_KEY=
# Full LiteLLM provider/model IDs, editable independently of client aliases.
OPENAI_MODEL=openai/gpt-5.4-mini
OPENAI_ALIAS=openai-chat
GEMINI_MODEL=gemini/gemini-3.1-flash-lite
GEMINI_ALIAS=gemini-chat

DISK_WARNING_GB=25
DISK_CRITICAL_GB=15
CORE_ESTIMATED_GB=12
