# Copy to .env and fill locally. NEVER COMMIT .env.

# Core
LITELLM_MASTER_KEY=replace-me-locally
POSTGRES_USER=litellm
POSTGRES_PASSWORD=replace-me-locally
POSTGRES_DB=litellm

# Providers
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Model IDs are intentionally configurable.
OPENAI_FAST_MODEL=
OPENAI_STANDARD_MODEL=
OPENAI_HARD_MODEL=
GEMINI_MODEL=
ANTHROPIC_MODEL=

# Optional local runtime
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Storage safety
DISK_WARNING_GB=25
DISK_CRITICAL_GB=15
